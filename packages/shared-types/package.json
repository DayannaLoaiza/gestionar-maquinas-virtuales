{
  "name": "@vm/shared-types",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Interfaces y tipos TypeScript compartidos entre backend y frontend",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vm/eslint-config": "workspace:*",
    "@vm/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
