NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (docker-compose.yml de la raíz publica el 5433). Con un PostgreSQL propio, ajustar la URL.
DATABASE_URL=postgres://vm:vm_dev_password@localhost:5433/vm_dev
# Base aparte para los tests e2e: se vacía en cada corrida. Nunca apuntarla a la de desarrollo.
TEST_DATABASE_URL=postgres://vm:vm_dev_password@localhost:5433/vm_test

# Secreto de firma del JWT: al menos 32 bytes aleatorios. Este valor es SOLO de desarrollo.
# Generar uno propio: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-cambiar-este-secreto-de-32-bytes-o-mas
# true salvo para probar con herramientas sobre http://localhost. En producción no puede ser false.
COOKIE_SECURE=true
# false: la IP del cliente es la de la conexión (detrás del rewrite de Next, la de Next: el límite de
# login por IP queda compartido entre usuarios; aceptable solo en desarrollo).
# Producción: un proxy delante de Next (nginx, balanceador) que SOBRESCRIBA X-Forwarded-For con la IP
# de la conexión, y aquí la dirección de Next (p. ej. loopback si corre en el mismo host). Nunca un
# número de saltos sin ese proxy: Next deja pasar el X-Forwarded-For del cliente y sería falsificable.
TRUST_PROXY=false

# Usuarios de prueba que crea `pnpm --filter @vm/backend db:seed` (solo desarrollo).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin-dev-2026!
SEED_CLIENT_EMAIL=cliente@example.com
SEED_CLIENT_PASSWORD=Cliente-dev-2026!
